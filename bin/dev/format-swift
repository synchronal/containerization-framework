#!/usr/bin/env bash
#
# Formats the bridge's Swift sources with swift-format, or checks that they
# are formatted.

set -euo pipefail

cd "$(dirname "$0")/../.."

usage() {
  echo "USAGE" >&2
  echo "  $0 --all" >&2
  echo "  $0 --check" >&2
  exit 1
}

if ! command -v swift-format >/dev/null; then
  echo "$0: swift-format is not installed; it ships with Xcode's toolchain" >&2
  exit 1
fi

case "${1:-}" in
  --all)
    swift-format format --configuration .swift-format.json --in-place --recursive swift
    ;;

  --check)
    sources=()
    while IFS= read -r -d '' source; do
      sources+=("$source")
    done < <(find swift -name '*.swift' -print0 | sort -z)

    unformatted=()
    for source in "${sources[@]}"; do
      formatted="$(swift-format format --configuration .swift-format.json "$source")"
      if [[ "$formatted" != "$(cat "$source")" ]]; then
        unformatted+=("$source")
      fi
    done

    if ((${#unformatted[@]} > 0)); then
      echo "These Swift files are not formatted; run $0 --all:" >&2
      printf '  %s\n' "${unformatted[@]}" >&2
      exit 1
    fi
    ;;

  *)
    echo "$0: unknown argument '${1:-}'" >&2
    usage
    ;;
esac
