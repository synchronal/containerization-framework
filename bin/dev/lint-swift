#!/usr/bin/env bash
#
# Lints the bridge's Swift sources with swift-format. Any finding fails.

set -euo pipefail

cd "$(dirname "$0")/../.."

if ! command -v swift-format >/dev/null; then
  echo "$0: swift-format is not installed; it ships with Xcode's toolchain" >&2
  exit 1
fi

swift-format lint --configuration .swift-format.json --strict --recursive swift
